{
    "name": "warete/moonshine-upgrade",
    "description": "Package for upgrade MoonShine",
    "keywords": ["moonshine", "upgrade"],
    "type": "library",
    "homepage": "https://getmoonshine.app",
    "license": "MIT",
    "support": {
        "issues": "https://github.com/:vendor_name/:package_name/issues",
        "source": "https://github.com/:vendor_name/:package_name"
    },
    "authors": [
        {
            "name": "Egor Borisovsky",
            "email": "egor.borisovskiy@gmail.com",
            "homepage": "https://github.com/warete"
        }
    ],
    "require": {
        "php": "^8.2",
        "rector/rector": "^2.0",
        "illuminate/support": "^10|^11|^12"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "orchestra/testbench": "^9.0"
    },
    "autoload": {
        "psr-4": {
            "Warete\\MoonshineUpgrade\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Warete\\MoonshineUpgrade\\Tests\\": "tests/",
            "Warete\\MoonshineUpgrade\\Database\\Factories\\": "database/factories/"
        }
    },
    "conflict": {
        "moonshine/moonshine": "<3.0"
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "rector": "vendor/bin/rector process --clear-cache",
        "format": "vendor/bin/php-cs-fixer fix --allow-risky=yes"
    }
}
